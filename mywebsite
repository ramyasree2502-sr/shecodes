<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>ShopSphere | Online Shopping with Java & C++</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', 'Fira Code', system-ui, -apple-system, monospace;
      background: #f0f2f5;
      color: #1a2c3e;
      line-height: 1.5;
    }

    /* Header */
    .shop-header {
      background: linear-gradient(135deg, #0f2c1f 0%, #1a4a2e 100%);
      padding: 1rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .header-container {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .logo h1 {
      color: #f5a623;
      font-size: 1.6rem;
    }
    .logo span {
      color: #e8e2d0;
      font-size: 0.8rem;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      list-style: none;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      padding: 0.4rem 1rem;
      border-radius: 30px;
      font-weight: 500;
      font-size: 0.85rem;
      transition: 0.2s;
      background: rgba(255,255,255,0.1);
    }

    .nav-links a:hover, .nav-links a.active {
      background: #f5a623;
      color: #1a2c3e;
    }

    .cart-badge {
      background: #f5a623;
      padding: 0.4rem 1.2rem;
      border-radius: 30px;
      font-weight: bold;
      color: #1a2c3e;
    }

    .container {
      max-width: 1400px;
      margin: 1.5rem auto;
      padding: 0 1.5rem 2rem;
      min-height: 65vh;
    }

    /* Hero */
    .hero {
      background: linear-gradient(120deg, #1e4d2e, #0f2c1f);
      padding: 3rem;
      border-radius: 2rem;
      color: white;
      text-align: center;
      margin-bottom: 2rem;
    }

    .btn {
      background: #f5a623;
      color: #1a2c3e;
      padding: 0.7rem 2rem;
      border-radius: 40px;
      font-weight: bold;
      text-decoration: none;
      display: inline-block;
      margin-top: 1rem;
      border: none;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn:hover {
      background: #ffc857;
      transform: translateY(-2px);
    }

    /* Product Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.8rem;
      margin: 2rem 0;
    }

    .product-card {
      background: white;
      border-radius: 1.5rem;
      padding: 1.2rem;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
      transition: all 0.2s;
      border: 1px solid #e0e7ed;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.12);
      border-color: #f5a623;
    }

    .product-emoji {
      font-size: 4rem;
      text-align: center;
      background: #f8f9fa;
      border-radius: 1rem;
      padding: 0.5rem;
    }

    .price {
      color: #1a4a2e;
      font-weight: bold;
      font-size: 1.3rem;
    }

    .add-btn {
      background: #1a4a2e;
      color: white;
      border: none;
      padding: 0.5rem;
      width: 100%;
      border-radius: 2rem;
      margin-top: 0.8rem;
      cursor: pointer;
      font-weight: bold;
    }

    /* Tables */
    table {
      width: 100%;
      background: white;
      border-radius: 1rem;
      overflow: hidden;
      border-collapse: collapse;
      margin: 1rem 0;
    }

    th, td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }

    th {
      background: #1a4a2e;
      color: white;
    }

    /* Code Blocks */
    pre {
      background: #1e1e2e;
      padding: 1rem;
      border-radius: 1rem;
      overflow-x: auto;
      font-family: 'Fira Code', monospace;
      font-size: 0.8rem;
      margin: 1rem 0;
      color: #e2e8f0;
      border-left: 4px solid #f5a623;
    }

    code {
      font-family: 'Fira Code', monospace;
    }

    .contact-form, .checkout-form {
      background: white;
      padding: 2rem;
      border-radius: 1.8rem;
      max-width: 600px;
      margin: 0 auto;
    }

    input, textarea, select {
      width: 100%;
      padding: 0.7rem;
      margin: 0.5rem 0 1rem;
      border-radius: 1rem;
      border: 1px solid #ccc;
    }

    footer {
      background: #0f2c1f;
      color: #cbd5e1;
      text-align: center;
      padding: 2rem;
      margin-top: 3rem;
    }

    @media (max-width: 800px) {
      .header-container {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
